# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o Git.

# Anthropic (Claude) — necessário a partir da Fase 3
ANTHROPIC_API_KEY=

# Groq (transcrição de áudio) — necessário a partir da Fase 6
GROQ_API_KEY=

# Banco de dados (SQLite no desenvolvimento)
# Opcional: sem isso, usa o arquivo nutria.db na raiz do projeto.
# DATABASE_URL=sqlite:///./nutria.db

# Fuso horário usado para "hoje", "almoço" etc.
TIMEZONE=America/Sao_Paulo

# Onde ficam as fotos e áudios recebidos. Opcional: sem isso, usa a pasta uploads/.
# PASTA_UPLOADS=./uploads

# Senha para abrir o simulador quando ele estiver num servidor público.
# Vazio (no PC) = sem senha. No servidor, preencha SEMPRE.
SENHA_ACESSO=
